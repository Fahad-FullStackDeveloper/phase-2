{
  "name": "todo-application-phase-2-fullstack",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && pip install -r requirements.txt && uvicorn src.main:app --reload",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
